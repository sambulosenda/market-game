# Copy to .env.local for local builds, or set these as EAS environment variables
# for each build profile. With a value missing, that service stays switched off.

# RevenueCat public SDK keys, one for each platform. With none, the gem shop is closed.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog project key and host. Use one project for development and another for production.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
