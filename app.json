{
  "expo": {
    "name": "Market Street",
    "slug": "market-street",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marketstreet",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sambulosenda.marketstreet",
      "supportsTablet": false
    },
    "android": {
      "package": "com.sambulosenda.marketstreet",
      "adaptiveIcon": {
        "backgroundColor": "#FBE3B5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBE3B5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
